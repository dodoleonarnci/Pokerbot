{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .lk-page { display: flex; flex-direction: column; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n  .lk-head { display: flex; flex-direction: column; gap: var(--cds-gap-xs); }\n  .lk-title { margin: 0; font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); text-wrap: balance; }\n  .lk-lede { margin: 0; max-width: 72ch; font-size: var(--cds-font-size-body); line-height: 1.5; }\n  .lk-meta { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .lk-page b { font-weight: 600; }\n  .lk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--cds-gap-md); }\n  .lk-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }\n  .lk-card h2 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n  .lk-note { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); line-height: 1.45; max-width: 80ch; }\n  .lk-chart { position: relative; min-height: 340px; }\n  .lk-chart.lk-tall { min-height: 560px; }\n  .lk-chart svg { display: block; overflow: visible; }\n  .lk-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); max-width: 280px; z-index: 2; line-height: 1.4; }\n  .lk-tip-head { color: var(--cds-text-secondary); margin-bottom: 2px; }\n  .lk-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .lk-swatch { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; vertical-align: -1px; }\n  .lk-swatch.lk-bar { border-radius: 2px; }\n  .lk-table-wrap { max-height: 440px; overflow: auto; }\n  .lk-table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .lk-table th { position: sticky; top: 0; background: var(--color-panel); text-align: left; font-weight: var(--cds-font-weight-medium); padding: 6px 8px; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .lk-table td { padding: 6px 8px; border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n  .lk-table .lk-num { text-align: right; white-space: nowrap; }\n  .lk-details { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); max-width: 80ch; line-height: 1.5; }\n  .lk-details summary { cursor: pointer; color: var(--color-fg); }\n  .lk-details dt { color: var(--color-fg); margin-top: var(--cds-gap-sm); }\n  .lk-details dd { margin: 0; }\n  [data-dash-source-state=empty] { color: transparent; }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"lk-page\">\n  <header class=\"lk-head\">\n    <h1 class=\"lk-title\" id=\"top\">Bot leak map</h1>\n    <p class=\"lk-lede\">Across <b data-draw=\"hands\" data-source=\"summary\" data-field=\"hands\" data-row=\"0\">\u2014</b> hands, the most exploitable spot is <b data-draw=\"top-label\" data-source=\"vulnerable\" data-field=\"label\" data-row=\"0\">\u2014</b>. Play: <b data-draw=\"top-play\" data-source=\"vulnerable\" data-field=\"play\" data-row=\"0\">\u2014</b>, worth about <b data-draw=\"top-value\" data-source=\"vulnerable\" data-field=\"value_per_1000\" data-row=\"0\">\u2014</b> pots per 1,000 hands.</p>\n    <p class=\"lk-meta\">Data: <span data-draw=\"source-label\" data-source=\"summary\" data-field=\"label\" data-row=\"0\">\u2014</span>. Opponents only: our own bot and filler seats are left out of every rate.</p>\n  </header>\n\n  <section class=\"lk-card\" id=\"leaks\">\n    <h2>Most exploitable spots</h2>\n    <p class=\"lk-note\">Profit per spot, in pots, times how often the spot comes up. Bluffing spots use how often every opponent folds to a bet. River spots use the hands that were called and shown down.</p>\n    <div class=\"lk-legend\">\n      <span><i class=\"lk-swatch lk-bar\" data-color=\"0\"></i>Folds too often: bluff</span>\n      <span><i class=\"lk-swatch lk-bar\" data-color=\"1\"></i>Bluffs too often: call</span>\n      <span><i class=\"lk-swatch lk-bar\" data-color=\"2\"></i>Bluffs too rarely: fold</span>\n    </div>\n    <div class=\"lk-chart\" data-draw=\"leaks\" data-source=\"vulnerable\">\u2014</div>\n  </section>\n\n  <div class=\"lk-grid\">\n    <section class=\"lk-card\" id=\"folding\">\n      <h2>Where they fold too much</h2>\n      <p class=\"lk-note\">Each dot is a betting spot: how often everyone folded to the bet. Above the line, a bet with no hand at all makes money on folds alone.</p>\n      <div class=\"lk-legend\">\n        <span><i class=\"lk-swatch\" data-color=\"0\"></i>Flop</span>\n        <span><i class=\"lk-swatch\" data-color=\"1\"></i>Turn</span>\n        <span><i class=\"lk-swatch\" data-color=\"2\"></i>River</span>\n      </div>\n      <div class=\"lk-chart\" data-draw=\"fold-scatter\" data-source=\"spots\">\u2014</div>\n    </section>\n    <section class=\"lk-card\" id=\"bluffing\">\n      <h2>Where they bluff too much</h2>\n      <p class=\"lk-note\">River bets that were called and shown down: the share made with no pair from their own cards. Above the line, calling with any hand that beats a bluff makes money.</p>\n      <div class=\"lk-legend\">\n        <span><i class=\"lk-swatch\" data-color=\"0\"></i>Heads-up</span>\n        <span><i class=\"lk-swatch\" data-color=\"3\"></i>Multiway</span>\n      </div>\n      <div class=\"lk-chart\" data-draw=\"bluff-scatter\" data-source=\"river\">\u2014</div>\n    </section>\n  </div>\n\n  <section class=\"lk-card\" id=\"em\">\n    <h2>Flop and turn bluff share: showdowns alone vs EM</h2>\n    <p class=\"lk-note\">Share of bets made with air or a weak draw. Flop and turn bluffs often win before showdown, so counting only shown hands misses them. EM uses every hand's whole line to correct for that.</p>\n    <div class=\"lk-legend\">\n      <span><i class=\"lk-swatch lk-bar\" data-color=\"0\"></i>EM estimate</span>\n      <span><i class=\"lk-swatch lk-bar\" data-muted=\"1\"></i>Shown hands only</span>\n    </div>\n    <div class=\"lk-chart\" data-draw=\"em-bars\" data-source=\"earlier\">\u2014</div>\n  </section>\n\n  <section class=\"lk-card\" id=\"tree\">\n    <h2>Heads-up game tree after the flop</h2>\n    <p class=\"lk-note\">Left to right is the order of play, and each block's height is how often the line happens. Color is the best pure-bluff profit available at that point. The more saturated the color, the more a bet with nothing wins or loses. Lines seen fewer than 30 times are left out.</p>\n    <div class=\"lk-legend\">\n      <span><i class=\"lk-swatch lk-bar\" data-color=\"0\"></i>Bluffing profits</span>\n      <span><i class=\"lk-swatch lk-bar\" data-muted=\"1\"></i>Break-even or no bets</span>\n      <span><i class=\"lk-swatch lk-bar\" data-color=\"1\"></i>Bluffing loses</span>\n    </div>\n    <div class=\"lk-chart lk-tall\" data-draw=\"tree\" data-source=\"hu_tree\">\u2014</div>\n  </section>\n\n  <section class=\"lk-card\" id=\"table\">\n    <h2>Spot list</h2>\n    <p class=\"lk-note\">The same spots as the top chart, with sample sizes.</p>\n    <div class=\"lk-table-wrap\">\n      <table class=\"lk-table\" data-source=\"vulnerable\" data-row-key=\"key\">\n        <thead>\n          <tr>\n            <th data-field=\"label\">Spot</th>\n            <th data-field=\"leak\">Leak</th>\n            <th data-field=\"play\">Play</th>\n            <th class=\"lk-num\" data-field=\"ev_per_spot\">Pots per spot</th>\n            <th class=\"lk-num\" data-field=\"per_1000_hands\">Per 1,000 hands</th>\n            <th class=\"lk-num\" data-field=\"value_per_1000\">Pots per 1,000 hands</th>\n            <th class=\"lk-num\" data-field=\"n\">Sample</th>\n          </tr>\n        </thead>\n        <tbody data-draw=\"leak-rows\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <details class=\"lk-details\">\n    <summary>How these numbers are worked out</summary>\n    <dl>\n      <dt>Spot</dt>\n      <dd>Street, heads-up or multiway, the bettor's role (raiser or caller before the flop, or what they did on the last street), whether they lead or bet after a check, and the bet's size as a share of the pot.</dd>\n      <dt>Folds too often</dt>\n      <dd>A bet of size s (as a share of the pot) with no hand breaks even when everyone folds s / (1 + s) of the time, a third for a half-pot bet. Above that, the profit per spot is the fold rate minus s times the call-or-raise rate, in pots.</dd>\n      <dt>Bluffs too often or too rarely</dt>\n      <dd>On the river a bet of size s is balanced when s / (1 + 2s) of the bets are bluffs, a quarter for a half-pot bet. A called river bet always reaches showdown, so those hands show the whole betting range. \"Bluff\" here means no pair made with their own cards. The value is what a hand that beats every bluff and loses to every value bet gains by calling (too many bluffs) or by folding (too few).</dd>\n      <dt>EM estimate</dt>\n      <dd>On the flop and turn, most bets never reach showdown. The estimate fits how opponents bet with each kind of hand, using every hand they played and each one's exposed card, and works out each bettor's most likely hidden card.</dd>\n      <dt>What's left out</dt>\n      <dd>Preflop spots, spots seen fewer than 30 times (10 for river showdowns), and our own bot's decisions. Folding bluff-catchers is valued as if we would always have called there, so that figure is an upper bound.</dd>\n    </dl>\n  </details>\n</div>\n\n<script>\n  dash.calc('vulnerable', {\n    title: 'Most exploitable spots',\n    description: 'Bluffing profit where opponents fold too much, and river bluff-catching gains, each times how often the spot comes up.',\n    inputs: ['spots', 'river'],\n    fn: (spots, river) => {\n      const roles = {PFA: 'raiser', caller: 'caller', limped: 'limped pot', agg: 'bet last street', def: 'called last street', checked: 'checked last street'};\n      const moves = {first: 'leads', 'checked-to': 'bets after a check', 'vs-bet': 'raises a bet', 'vs-raise': 're-raises'};\n      const name = (r) => [r.street[0].toUpperCase() + r.street.slice(1), r.players === 'HU' ? 'heads-up' : 'multiway',\n        roles[r.role] || r.role, moves[r.situation] || r.situation, r.bet_size].join(' \u00b7 ');\n      const often = Object.fromEntries(spots.map((s) => [s.spot, s.per_1000_hands]));\n      const rows = spots.filter((s) => s.bluff_ev_pots > 0).map((s) => ({\n        key: 'fold|' + s.spot, label: name(s), leak: 'Folds too often', play: 'Bluff with any hand',\n        ev_per_spot: s.bluff_ev_pots, per_1000_hands: s.per_1000_hands, value_per_1000: s.bluff_ev_pots * s.per_1000_hands, n: s.n}));\n      for (const r of river) {\n        const over = r.bluffcatch_ev_pots > 0;\n        const f = often[r.spot] ?? 0;\n        rows.push({key: 'river|' + r.spot, label: name(r), leak: over ? 'Bluffs too often' : 'Bluffs too rarely',\n          play: over ? 'Call with bluff-catchers' : 'Fold bluff-catchers', ev_per_spot: Math.abs(r.bluffcatch_ev_pots),\n          per_1000_hands: f, value_per_1000: Math.abs(r.bluffcatch_ev_pots) * f, n: r.n});\n      }\n      return rows.sort((a, b) => b.value_per_1000 - a.value_per_1000).slice(0, 20);\n    },\n  });\n</script>\n\n<script>\n  window.lkKit = (() => {\n    const pct = d3.format('.0%');\n    const pct1 = d3.format('.1%');\n    const pots = d3.format('+.2f');\n    const comma = d3.format(',');\n    const two = d3.format('.2f');\n    const cssVar = (el, name) => getComputedStyle(el).getPropertyValue(name).trim();\n    const placeholder = (el) => { el.replaceChildren(); el.textContent = '\u2014'; };\n    const tip = (el) => {\n      const box = document.createElement('div');\n      box.className = 'lk-tip';\n      box.hidden = true;\n      el.appendChild(box);\n      return {\n        show(event, head, lines) {\n          box.replaceChildren();\n          const h = document.createElement('div');\n          h.className = 'lk-tip-head';\n          h.textContent = head;\n          box.appendChild(h);\n          for (const line of lines) {\n            const d = document.createElement('div');\n            d.textContent = line;\n            box.appendChild(d);\n          }\n          box.hidden = false;\n          const rect = el.getBoundingClientRect();\n          const x = event.clientX - rect.left;\n          const y = event.clientY - rect.top;\n          const w = box.offsetWidth;\n          const h2 = box.offsetHeight;\n          box.style.left = Math.max(0, Math.min(rect.width - w, x + 12)) + 'px';\n          box.style.top = Math.max(0, Math.min(rect.height - h2, y - h2 - 10 < 0 ? y + 14 : y - h2 - 10)) + 'px';\n        },\n        hide() { box.hidden = true; },\n      };\n    };\n    const streetColor = {flop: 0, turn: 1, river: 2};\n    const leakColor = {'Folds too often': 0, 'Bluffs too often': 1, 'Bluffs too rarely': 2};\n    const axisStyle = (g, el) => {\n      g.attr('font-size', null).attr('font-family', null);\n      g.selectAll('text').attr('fill', cssVar(el, '--color-fg-muted')).style('font-size', 'var(--cds-font-size-caption)');\n      g.selectAll('line').attr('stroke', cssVar(el, '--cds-chart-grid'));\n      g.select('.domain').attr('stroke', cssVar(el, '--cds-chart-axis'));\n    };\n    return {pct, pct1, pots, comma, two, cssVar, placeholder, tip, streetColor, leakColor, axisStyle};\n  })();\n\n  for (const swatch of document.querySelectorAll('.lk-swatch[data-color]')) {\n    swatch.style.background = dash.colors[Number(swatch.dataset.color)];\n  }\n  for (const swatch of document.querySelectorAll('.lk-swatch[data-muted]')) {\n    swatch.style.background = 'var(--cds-chart-muted)';\n  }\n</script>\n\n<script>\n  const {pct, pct1, pots, comma, two, cssVar, placeholder, tip, streetColor, leakColor, axisStyle} = window.lkKit;\n\n  const firstRow = (id) => {\n    const g = dash.data(id);\n    return g.status === 'ok' && g.data.length ? g.data[0] : null;\n  };\n  dash.draw('hands', (el) => { const r = firstRow('summary'); el.textContent = r ? comma(r.hands) : '\u2014'; });\n  dash.draw('source-label', (el) => { const r = firstRow('summary'); el.textContent = r ? r.label : '\u2014'; });\n  dash.draw('top-label', (el) => { const r = firstRow('vulnerable'); el.textContent = r ? r.label : '\u2014'; });\n  dash.draw('top-play', (el) => { const r = firstRow('vulnerable'); el.textContent = r ? r.play.toLowerCase() : '\u2014'; });\n  dash.draw('top-value', (el) => { const r = firstRow('vulnerable'); el.textContent = r ? two(r.value_per_1000) : '\u2014'; });\n\n  dash.draw('leaks', (el) => {\n    const g = dash.data('vulnerable');\n    if (g.status !== 'ok' || !g.data.length) return placeholder(el);\n    el.replaceChildren();\n    const rows = g.data.slice(0, 12);\n    const width = Math.max(320, el.clientWidth);\n    const rowH = 42;\n    const height = rows.length * rowH + 8;\n    const valueRoom = 56;\n    const x = d3.scaleLinear([0, d3.max(rows, (r) => r.value_per_1000) || 1], [0, width - valueRoom]);\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${width} ${height}`);\n    const t = tip(el);\n    const fg = cssVar(el, '--color-fg');\n    const muted = cssVar(el, '--color-fg-muted');\n    const row = svg.selectAll('g').data(rows).join('g').attr('transform', (_, i) => `translate(0,${i * rowH})`);\n    row.append('text').attr('x', 0).attr('y', 13).attr('fill', fg).style('font-size', 'var(--cds-font-size-caption)')\n      .text((r) => r.label);\n    row.append('rect').attr('x', 0).attr('y', 20).attr('height', 14).attr('rx', 3)\n      .attr('width', (r) => Math.max(2, x(r.value_per_1000)))\n      .attr('fill', (r) => dash.colors[leakColor[r.leak] ?? 0]);\n    row.append('text').attr('x', (r) => Math.max(2, x(r.value_per_1000)) + 6).attr('y', 31).attr('fill', muted)\n      .style('font-size', 'var(--cds-font-size-caption)').style('font-variant-numeric', 'tabular-nums')\n      .text((r) => two(r.value_per_1000));\n    row.append('rect').attr('x', 0).attr('y', 0).attr('width', width).attr('height', rowH).attr('fill', 'transparent')\n      .on('mousemove', (event, r) => t.show(event, r.label, [\n        `${r.leak}: ${r.play.toLowerCase()}`,\n        `${pots(r.ev_per_spot)} pots per spot`,\n        `Comes up ${two(r.per_1000_hands)} times per 1,000 hands`,\n        `${two(r.value_per_1000)} pots per 1,000 hands`,\n        `Sample: ${comma(r.n)}`]))\n      .on('mouseleave', () => t.hide());\n  });\n\n  const scatter = (el, rows, opts) => {\n    el.replaceChildren();\n    const width = Math.max(300, el.clientWidth);\n    const height = 340;\n    const m = {top: 12, right: 14, bottom: 40, left: 44};\n    const xMax = Math.min(3, Math.max(1.3, d3.max(rows, (r) => r.mean_size) || 1));\n    const x = d3.scaleLinear([0, xMax], [m.left, width - m.right]);\n    const y = d3.scaleLinear([0, 1], [height - m.bottom, m.top]);\n    const r = d3.scaleSqrt([0, d3.max(rows, (d) => d.n) || 1], [3, 11]);\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${width} ${height}`);\n    const curve = d3.range(0, xMax + 0.001, xMax / 80).map((s) => [s, opts.line(s)]);\n    const zone = d3.area().x((d) => x(d[0])).y0((d) => y(d[1])).y1(y(1));\n    svg.append('path').datum(curve).attr('d', zone).attr('fill', cssVar(el, '--cds-chart-grid')).attr('opacity', 0.6);\n    svg.append('g').attr('transform', `translate(0,${height - m.bottom})`)\n      .call(d3.axisBottom(x).ticks(Math.max(3, Math.floor(width / 90))).tickFormat(pct).tickSize(-(height - m.top - m.bottom)))\n      .call((g) => axisStyle(g, el));\n    svg.append('g').attr('transform', `translate(${m.left},0)`)\n      .call(d3.axisLeft(y).ticks(5).tickFormat(pct).tickSize(-(width - m.left - m.right)))\n      .call((g) => axisStyle(g, el));\n    svg.append('path').datum(curve).attr('d', d3.line().x((d) => x(d[0])).y((d) => y(d[1])))\n      .attr('fill', 'none').attr('stroke', cssVar(el, '--cds-chart-reference')).attr('stroke-width', 2).attr('stroke-dasharray', '6 4');\n    svg.append('text').attr('x', m.left + 8).attr('y', m.top + 14).attr('fill', cssVar(el, '--color-fg-muted'))\n      .style('font-size', 'var(--cds-font-size-caption)').text(opts.zoneLabel);\n    svg.append('text').attr('x', width - m.right).attr('y', height - 6).attr('text-anchor', 'end')\n      .attr('fill', cssVar(el, '--color-fg-muted')).style('font-size', 'var(--cds-font-size-caption)').text('Bet size, share of the pot');\n    const t = tip(el);\n    const ring = cssVar(el, '--color-panel');\n    svg.append('g').selectAll('circle').data(rows.slice().sort((a, b) => b.n - a.n)).join('circle')\n      .attr('cx', (d) => x(Math.min(xMax, d.mean_size))).attr('cy', (d) => y(opts.value(d))).attr('r', (d) => r(d.n))\n      .attr('fill', (d) => dash.colors[opts.color(d)]).attr('fill-opacity', 0.85).attr('stroke', ring).attr('stroke-width', 2)\n      .on('mousemove', (event, d) => t.show(event, opts.title(d), opts.lines(d)))\n      .on('mouseleave', () => t.hide());\n  };\n\n  const spotTitle = (d) => [d.street[0].toUpperCase() + d.street.slice(1), d.players === 'HU' ? 'heads-up' : 'multiway',\n    d.role, d.situation, d.bet_size].join(' \u00b7 ');\n\n  dash.draw('fold-scatter', (el) => {\n    const g = dash.data('spots');\n    if (g.status !== 'ok' || !g.data.length) return placeholder(el);\n    scatter(el, g.data, {\n      line: (s) => s / (1 + s), value: (d) => d.fold_through, color: (d) => streetColor[d.street] ?? 0,\n      zoneLabel: 'Bluffs profit above the line', title: spotTitle,\n      lines: (d) => [`Everyone folded ${pct1(d.fold_through)} (break-even ${pct1(d.breakeven)})`,\n        `Pure bluff: ${pots(d.bluff_ev_pots)} pots per bet`, `Average size ${pct(d.mean_size)} of the pot`, `Sample: ${comma(d.n)} bets`],\n    });\n  });\n\n  dash.draw('bluff-scatter', (el) => {\n    const g = dash.data('river');\n    if (g.status !== 'ok' || !g.data.length) return placeholder(el);\n    scatter(el, g.data, {\n      line: (s) => s / (1 + 2 * s), value: (d) => d.air_share, color: (d) => (d.players === 'HU' ? 0 : 3),\n      zoneLabel: 'Too many bluffs above the line', title: spotTitle,\n      lines: (d) => [`No pair: ${pct1(d.air_share)} (balanced ${pct1(d.balanced)})`,\n        `Caller won ${pct1(d.caller_won)} of showdowns`, `Calling a bluff-catcher: ${pots(d.bluffcatch_ev_pots)} pots`,\n        `Sample: ${comma(d.n)} called bets`],\n    });\n  });\n\n  dash.draw('em-bars', (el) => {\n    const g = dash.data('earlier');\n    if (g.status !== 'ok') return placeholder(el);\n    const rows = g.data.filter((d) => d.em_n >= 100 && d.shown_n >= 10 && d.em_bluff != null && d.shown_bluff != null)\n      .sort((a, b) => b.em_n - a.em_n).slice(0, 10);\n    if (!rows.length) return placeholder(el);\n    el.replaceChildren();\n    const width = Math.max(320, el.clientWidth);\n    const rowH = 50;\n    const height = rows.length * rowH + 24;\n    const x = d3.scaleLinear([0, 1], [0, width - 52]);\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${width} ${height}`);\n    const t = tip(el);\n    const fg = cssVar(el, '--color-fg');\n    const muted = cssVar(el, '--color-fg-muted');\n    const grey = cssVar(el, '--cds-chart-muted');\n    const row = svg.selectAll('g').data(rows).join('g').attr('transform', (_, i) => `translate(0,${i * rowH})`);\n    row.append('text').attr('y', 12).attr('fill', fg).style('font-size', 'var(--cds-font-size-caption)').text(spotTitle);\n    for (const [i, key, color] of [[0, 'em_bluff', dash.colors[0]], [1, 'shown_bluff', grey]]) {\n      row.append('rect').attr('y', 18 + i * 13).attr('height', 11).attr('rx', 3)\n        .attr('width', (d) => Math.max(2, x(d[key]))).attr('fill', color);\n      row.append('text').attr('x', (d) => Math.max(2, x(d[key])) + 6).attr('y', 27 + i * 13).attr('fill', muted)\n        .style('font-size', 'var(--cds-font-size-caption)').style('font-variant-numeric', 'tabular-nums').text((d) => pct(d[key]));\n    }\n    row.append('rect').attr('width', width).attr('height', rowH).attr('fill', 'transparent')\n      .on('mousemove', (event, d) => t.show(event, spotTitle(d), [\n        `EM: ${pct1(d.em_bluff)} air or weak draw (${comma(d.em_n)} bets)`,\n        `Shown hands only: ${pct1(d.shown_bluff)} (${comma(d.shown_n)} shown)`,\n        `EM mix: ${pct(d.em_air)} air, ${pct(d.em_weak_draw)} weak draw, ${pct(d.em_strong_draw)} strong draw, ${pct(d.em_weak_pair)} weak pair, ${pct(d.em_top_pair)} top pair, ${pct(d.em_strong)} two pair or better`]))\n      .on('mouseleave', () => t.hide());\n  });\n\n  dash.draw('tree', (el) => {\n    const g = dash.data('hu_tree');\n    if (g.status !== 'ok' || !g.data.length) return placeholder(el);\n    el.replaceChildren();\n    const rows = [{id: '__all', parent: null, label: 'Heads-up pots', count: 0}, ...g.data.map((d) => ({...d, parent: d.parent || '__all'}))];\n    const childSum = d3.rollup(rows.filter((d) => d.parent), (v) => d3.sum(v, (d) => d.count), (d) => d.parent);\n    const root = d3.stratify().id((d) => d.id).parentId((d) => d.parent)(rows)\n      .sum((d) => Math.max(0, d.count - (childSum.get(d.id) || 0)))\n      .sort((a, b) => b.value - a.value);\n    const depth = root.height;\n    const width = Math.max(320, el.clientWidth);\n    const height = 560;\n    const column = width / depth;\n    d3.partition().size([height, width + column])(root);\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${width} ${height}`);\n    const t = tip(el);\n    const grey = cssVar(el, '--cds-chart-muted');\n    const good = d3.interpolateRgb(grey, dash.colors[0]);\n    const bad = d3.interpolateRgb(grey, dash.colors[1]);\n    const fill = (d) => {\n      const ev = d.data.best_bluff_ev;\n      if (ev == null) return grey;\n      return ev >= 0 ? good(Math.min(1, ev / 0.5)) : bad(Math.min(1, -ev / 0.5));\n    };\n    const fg = cssVar(el, '--color-fg');\n    const panel = cssVar(el, '--color-panel');\n    const nodes = root.descendants().filter((d) => d.depth > 0);\n    const cell = svg.selectAll('g').data(nodes).join('g').attr('transform', (d) => `translate(${d.y0 - column},${d.x0})`);\n    cell.append('rect').attr('width', (d) => Math.max(0, d.y1 - d.y0 - 2)).attr('height', (d) => Math.max(0, d.x1 - d.x0 - 2))\n      .attr('rx', 3).attr('fill', fill).attr('stroke', panel).attr('stroke-width', 0)\n      .on('mousemove', (event, d) => {\n        const r = d.data;\n        const shares = ['check', 'bet', 'call', 'fold', 'raise'].filter((k) => r[k] > 0).map((k) => `${k} ${pct(r[k])}`).join(', ');\n        const path = d.ancestors().reverse().slice(1).map((a) => a.data.label);\n        t.show(event, path.join(' \u2192 '), [\n          `Next: ${r.actor} acts, ${comma(r.count)} times`, shares ? `Does: ${shares}` : 'No decisions recorded',\n          r.best_bet_size ? `Best bluff: ${r.best_bet_size} bet, everyone folds ${pct1(r.best_fold_through)}, ${pots(r.best_bluff_ev)} pots (${comma(r.best_bets_n)} bets)` : 'Too few bets here to rate a bluff']);\n      })\n      .on('mouseleave', () => t.hide());\n    cell.filter((d) => d.x1 - d.x0 >= 16 && d.y1 - d.y0 >= 70).append('text')\n      .attr('x', 6).attr('y', 13).attr('fill', fg).style('font-size', 'var(--cds-font-size-caption)').style('pointer-events', 'none')\n      .text((d) => {\n        const room = Math.floor((d.y1 - d.y0 - 12) / 6.4);\n        const label = d.data.label;\n        return label.length > room ? label.slice(0, Math.max(1, room - 1)) + '\u2026' : label;\n      });\n  });\n\n  dash.draw('leak-rows', (tbody) => {\n    const g = dash.data('vulnerable');\n    tbody.replaceChildren();\n    if (g.status !== 'ok') return;\n    for (const r of g.data) {\n      const tr = document.createElement('tr');\n      tr.dataset.key = r.key;\n      const cells = [[r.label, ''], [r.leak, ''], [r.play, ''], [pots(r.ev_per_spot), 'lk-num'],\n        [two(r.per_1000_hands), 'lk-num'], [two(r.value_per_1000), 'lk-num'], [comma(r.n), 'lk-num']];\n      for (const [text, cls] of cells) {\n        const td = document.createElement('td');\n        td.textContent = text;\n        if (cls) td.className = cls;\n        tr.appendChild(td);\n      }\n      tbody.appendChild(tr);\n    }\n  });\n</script>\n", "edit": {"via": "claude", "at": "2026-11-07T02:51:28Z"}}